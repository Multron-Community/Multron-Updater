<Window x:Class="MultronUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multron Updater" Width="1040" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/app.ico" FontFamily="Segoe UI" FontSize="13">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/app.ico" Width="38" Height="38"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Multron Updater" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Keeps your programs up to date from GitHub automatically" Foreground="#8B949E" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="2" x:Name="AutoBadge" CornerRadius="12" Padding="11,5" Background="#30363D"
                        VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="AutoBadge_Click"
                        ToolTip="Click to turn automatic updates on or off">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AutoDot" Width="8" Height="8" Fill="#8B949E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoBadgeText" Text="Auto update: OFF" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="SavedText" Foreground="{DynamicResource AccentDarkBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="Settings are saved automatically when you change them"/>
                    <Button x:Name="CheckAllButton" Content="Check all now" Margin="0,0,8,0" Click="CheckAllButton_Click"
                            ToolTip="Check every enabled target and update the ones that changed"/>
                    <Button x:Name="SaveButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <ProgressBar x:Name="BusyBar" DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                     Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"/>

        <TabControl x:Name="Tabs" Margin="20,10,20,0" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0,12,0,0">

            <TabItem Header="Targets">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Targets" Style="{StaticResource CardTitle}" Margin="6,2,0,8"/>
                            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                                <Button Content="+ Add" Margin="0,0,4,0" Padding="6,6" Click="AddProfile_Click" ToolTip="Add a new target"/>
                                <Button Content="Duplicate" Margin="2,0" Padding="6,6" Click="DuplicateProfile_Click" ToolTip="Copy the selected target"/>
                                <Button Content="Remove" Margin="4,0,0,0" Padding="6,6" Click="RemoveProfile_Click" ToolTip="Delete the selected target"/>
                            </UniformGrid>
                            <ListBox x:Name="ProfileList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ProfileList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,7"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="dot" Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SourceText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="status" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="dot" Property="Fill" Value="{DynamicResource TrackOffBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                <Setter TargetName="status" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel x:Name="Editor">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Target name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="NameBox" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                            <Button x:Name="CheckButton" Content="Check this target" Margin="0,0,8,0" Click="CheckButton_Click"
                                                    ToolTip="Check GitHub now and update this target if something changed"/>
                                            <Button x:Name="ForceButton" Content="Force update" Click="ForceButton_Click"
                                                    ToolTip="Download all files again and run the after-update actions"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="EnabledCheck" Content="Enabled (included in automatic updates and &quot;Check all now&quot;)" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="1.  Update source" Style="{StaticResource CardTitle}"/>

                                    <TextBlock Text="GitHub link (optional – fills the fields below)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="UrlBox" ToolTip="e.g. https://github.com/user/repo/blob/main/bin/Release/App.exe"/>
                                        <Button Grid.Column="1" Content="Fill from link" Margin="8,0,0,0" Click="FillFromLink_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Paste a link like https://github.com/user/repo/blob/main/bin/Release/App.exe"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Owner (user or organization)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="OwnerBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Repository" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="RepoBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Branch" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="BranchBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Path in repository (file or folder)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="RepoPathBox"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="A single file (bin/Release/App.exe) or a folder (bin/Release). With a folder, every file inside it is kept in sync."/>

                                    <TextBlock Text="Update source" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <StackPanel>
                                        <RadioButton x:Name="SourceBothRadio" GroupName="UpdateSource" Margin="0,2,0,0" Checked="Source_Changed">
                                            <TextBlock TextWrapping="Wrap"><Run Text="Repository files + releases" FontWeight="SemiBold"/><Run Text="  (default) – sees a push right away; new releases add the files the repository does not have" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton x:Name="SourceRepoRadio" GroupName="UpdateSource" Margin="0,4,0,0" Checked="Source_Changed">
                                            <TextBlock TextWrapping="Wrap"><Run Text="Repository files only" FontWeight="SemiBold"/><Run Text="  – raw files from the branch, checked with their hash; a &lt;file&gt;.sha256 next to a file is verified too" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton x:Name="SourceReleasesRadio" GroupName="UpdateSource" Margin="0,4,0,0" Checked="Source_Changed">
                                            <TextBlock TextWrapping="Wrap"><Run Text="Releases only" FontWeight="SemiBold"/><Run Text="  – installs the files of the latest GitHub release, verified with SHA-256" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton x:Name="SourceLocalRadio" GroupName="UpdateSource" Margin="0,4,0,0" Checked="Source_Changed">
                                            <TextBlock TextWrapping="Wrap"><Run Text="Local repository folder (no internet)" FontWeight="SemiBold"/><Run Text="  – a copy of the repository on this computer, a USB drive or a share; files are compared with SHA-256" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                                        </RadioButton>
                                    </StackPanel>

                                    <Border x:Name="LocalOptions" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Local repository folder" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="LocalRepoBox"
                                                         ToolTip="Root of the repository copy, e.g. C:\Users\me\GitHub\HydraDragonAntivirus or E:\HydraDragonAntivirus"/>
                                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseLocalRepo_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                                       Text="Path in repository is read from this folder (empty = the whole folder; .git is skipped). Nothing is downloaded: the changed files are copied, checked with SHA-256 (and a &lt;file&gt;.sha256 next to them) and installed the same way as GitHub updates, with maintenance, backup and rollback. Owner, repository, branch and token are not used."/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ReleaseOptions" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Release file(s) to install" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="AssetBox" FontFamily="Cascadia Mono, Consolas"
                                                         ToolTip="File name of the release asset. Wildcards and several names: MyApp-*.zip;Readme.txt"/>
                                                <Button Grid.Column="1" x:Name="CheckReleaseButton" Content="Show latest release" Margin="8,0,0,0" Click="ShowRelease_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="AssetHint" Style="{StaticResource Hint}"/>
                                            <CheckBox x:Name="ExtractZipCheck" Content="Extract .zip files into the target folder" Margin="0,8,0,0"/>
                                            <TextBlock x:Name="ReleaseInfoText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                            <ItemsControl x:Name="ReleaseAssetList" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Mark}" Foreground="{DynamicResource SuccessFgBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextBrush}"/>
                                                                <Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                                            </TextBlock>
                                                            <Button Grid.Column="2" Content="Use this file" Padding="10,3" FontSize="12" Margin="8,0,0,0"
                                                                    Tag="{Binding}" Click="UseReleaseAsset_Click"
                                                                    ToolTip="Fill in the release file (and the program, for an .exe) with * in place of the version"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Access token (optional)" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="TokenBox"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Only needed for private repositories or if you hit GitHub's request limit. Stored encrypted for your Windows user."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="2.  Program on this computer" Style="{StaticResource CardTitle}"/>

                                    <TextBlock Text="Target folder (where the files are installed)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FolderBox"/>
                                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                                        <Button Grid.Column="2" Content="Open" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                                    </Grid>

                                    <TextBlock Text="Program to close while updating (.exe, optional)" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExeBox"/>
                                        <Button Grid.Column="1" x:Name="RunningButton" Content="Running..." Margin="8,0,0,0" Click="PickRunning_Click"
                                                ToolTip="Pick a running program (e.g. the server to close); the folder and the program are filled in with * in place of the version"/>
                                        <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Click="BrowseExe_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="This program is closed before the files are replaced and started again afterwards (if chosen). Use * for the version in versioned names, e.g. App-*-win64.exe: the running version is closed, the new release keeps its own name and the previous exe is removed."/>

                                    <TextBlock Text="Program type" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="WindowsAppRadio" GroupName="ProgramType" Content="Windows app" Margin="0,0,20,0"
                                                     VerticalContentAlignment="Center" Checked="ProgramType_Changed"/>
                                        <RadioButton x:Name="ConsoleAppRadio" GroupName="ProgramType" Content="Console app"
                                                     VerticalContentAlignment="Center" Checked="ProgramType_Changed"/>
                                        <TextBlock x:Name="DetectedTypeText" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="NoAdminCheck" Margin="0,8,0,0"
                                              Content="Start it as a normal user, without administrator rights (recommended for browsers)"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Multron Updater runs as administrator. Without this option the programs it starts run as administrator too."/>

                                    <TextBlock Text="Start arguments (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ArgsBox" FontFamily="Cascadia Mono, Consolas"
                                                 ToolTip="Passed to the program when it is started, e.g. --port 8080 --silent"/>
                                        <Button Grid.Column="1" Content="Start now" Margin="8,0,0,0" Click="StartNow_Click"
                                                ToolTip="Start the program now with these settings (to try them out)"/>
                                        <Button x:Name="StopNowButton" Grid.Column="2" Content="Close it" Margin="8,0,0,0" Click="StopNow_Click"
                                                ToolTip="Close the program if it is running (Ctrl+C or close its window, terminated after 5 seconds)"/>
                                    </Grid>

                                    <Border x:Name="ConsoleOptions" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Console window" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <RadioButton x:Name="ConsoleShowRadio" GroupName="ConsoleWindow" Content="Show the console window" Margin="0,4,0,0"/>
                                            <RadioButton x:Name="ConsoleKeepRadio" GroupName="ConsoleWindow" Content="Show it and keep it open after the program exits (to read errors)" Margin="0,4,0,0"/>
                                            <RadioButton x:Name="ConsoleHiddenRadio" GroupName="ConsoleWindow" Content="Run hidden in the background and write the output to a log file" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"
                                                           Text="When closing for an update, Ctrl+C is sent first; the program is terminated if it does not exit within 5 seconds."/>
                                            </StackPanel>
                                            <Button Content="Open console log" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" Click="OpenConsoleLog_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="DevServerPanel" Visibility="Collapsed">
                                    <CheckBox x:Name="ServerMaintCheck" Margin="0,10,0,0"
                                              Content="Multron server: switch it to &quot;Updating server&quot; maintenance before closing it"/>
                                    <CheckBox x:Name="ServerReloadCheck" Margin="0,6,0,0"
                                              Content="Multron server: when no .exe / .dll changed, reload its signatures instead of restarting it"
                                              ToolTip="Signature and rule files are replaced while the server keeps running, then the server reloads them (its dashboard's engine reload). Files held open by the server: it is closed and started as usual."/>
                                    <CheckBox x:Name="ServerSeamlessCheck" Margin="0,6,0,0"
                                              Content="Multron server: seamless update (the new version loads next to the running server; scans continue)"
                                              ToolTip="The running exe is renamed (*.old-&lt;time&gt;), the new files are put in place and the new version is started with --handoff. The running server keeps scanning (&quot;Getting updated&quot;) until the new one has loaded its engine, then hands its ports over in a few seconds. If the new version does not take over, the previous files are put back and the running server stays. A server too old for it is updated the usual way once."/>
                                    <StackPanel x:Name="ServerMaintPanel" Margin="22,6,0,0">
                                        <CheckBox x:Name="ServerUseGlobalCheck" Margin="0,0,0,6"
                                                  Content="Use the global server settings (General → Multron developers)"/>
                                        <Grid x:Name="ServerOwnGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Server dashboard" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="ServerUrlBox" Grid.Column="1" FontFamily="Cascadia Mono, Consolas"
                                                     ToolTip="The server's dashboard address on this computer (its --ui address), e.g. http://127.0.0.1:9440"/>
                                            <TextBlock Grid.Column="2" Text="Wait up to" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <TextBox x:Name="DrainBox" Grid.Column="3" ToolTip="Seconds to wait for scans in progress (0-600)"/>
                                            <TextBlock Grid.Column="4" Text="s for scans" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Clients are told &quot;Under maintenance: the server is being updated&quot; instead of losing the connection without a word, and scans in progress finish first. The updated server starts with scans open again; a normal maintenance mode that was on stays on. If the server is not running, the update goes on as usual."/>
                                    </StackPanel>
                                    </StackPanel>

                                    <CheckBox x:Name="BackupCheck" Content="Keep a backup of replaced files (last 3 updates)" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Build from source (optional)" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="BuildEnabledCheck" Margin="0,0,0,0"
                                              Content="Build the program from the downloaded source before installing it"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The repository (or the local repository folder) is kept in a source folder, your build commands run there with the compilers installed on this computer, and the files of the output folder are installed into the target folder. A failed build never touches the installed program. Leave &quot;Path in repository&quot; empty to download the whole repository."/>

                                    <StackPanel x:Name="BuildPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Source folder (where the source is kept and built)" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BuildSourceBox" FontFamily="Cascadia Mono, Consolas"
                                                     ToolTip="Empty = %AppData%\MultronUpdater\sources\&lt;target id&gt;"/>
                                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="BrowseBuildSource_Click"/>
                                            <Button Grid.Column="2" Content="Open" Margin="8,0,0,0" Click="OpenBuildSource_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="BuildSourceHint" Style="{StaticResource Hint}"/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Shell" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}"/>
                                            <ComboBox x:Name="BuildShellBox" Grid.Column="1" SelectedIndex="0">
                                                <ComboBoxItem Content="Command Prompt (cmd)"/>
                                                <ComboBoxItem Content="Windows PowerShell"/>
                                                <ComboBoxItem Content="PowerShell 7 (pwsh)"/>
                                            </ComboBox>
                                            <ComboBox x:Name="BuildTemplateBox" Grid.Column="3" Width="250" Margin="8,0,0,0"
                                                      ToolTip="Fills in the shell, commands and output folder; edit them afterwards"/>
                                            <Button Grid.Column="4" Content="Detect" Margin="8,0,0,0" Click="DetectBuild_Click"
                                                    ToolTip="Pick a template from the files in the source folder (.csproj, package.json, Cargo.toml...)"/>
                                        </Grid>

                                        <TextBlock Text="Build commands (one per line; they run in one shell, so cd and set carry over)" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                                        <TextBox x:Name="BuildCommandsBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" MinHeight="110" MaxHeight="260"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Variables: %MU_SOURCE% (source folder), %MU_OUTPUT% (output folder), %MU_TARGET% (target folder), %MU_VERSION% (commit), %MU_EXE%, %MU_TARGET_NAME% — in PowerShell: $env:MU_SOURCE ..."/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Output folder (relative to the source folder)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="BuildOutputBox" FontFamily="Cascadia Mono, Consolas"
                                                         ToolTip="Its files are installed into the target folder, e.g. publish or bin\Release\net8.0-windows\win-x64\publish"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Working folder (relative, optional)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="BuildWorkDirBox" FontFamily="Cascadia Mono, Consolas"
                                                         ToolTip="Folder the commands start in; empty = the source folder"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Environment variables (optional, one NAME=value per line)" Style="{StaticResource FieldLabel}" Margin="0,8,0,3"/>
                                        <TextBox x:Name="BuildEnvBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="44" MaxHeight="120"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Stop the build after" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBox x:Name="BuildTimeoutBox" Width="60"/>
                                            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="BuildStopOnErrorCheck" Content="Stop at the first command that fails (exit code not 0)" Margin="0,8,0,0"/>
                                        <CheckBox x:Name="BuildCleanCheck" Content="Empty the output folder before each build"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BuildNowButton" Content="Build and install now" Style="{StaticResource PrimaryButton}" Click="BuildNow_Click"
                                                    ToolTip="Downloads the changes (if any), builds and installs, even when the source has not changed"/>
                                            <Button Content="Open build log" Margin="8,0,0,0" Click="OpenBuildLog_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="3.  Files to update" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="OnlyFilesCheck" Content="Update only the checked files, in groups" Margin="0,0,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Off: every file under the repository path is updated and section 4 decides what happens afterwards. On: only checked files in enabled groups are updated, and each group runs its own actions when one of its files changes."/>

                                    <Grid Margin="0,12,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="FileFilterBox" TextChanged="FileFilter_Changed"/>
                                            <TextBlock Text="Filter files..." Foreground="{DynamicResource PlaceholderBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=FileFilterBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1" Content="+ New group" Margin="8,0,0,0" Click="NewGroup_Click"/>
                                        <Button Grid.Column="2" Content="Add files..." Margin="8,0,0,0" Click="AddFiles_Click"/>
                                        <Button Grid.Column="3" x:Name="LoadFilesButton" Content="Load from GitHub" Margin="8,0,0,0" Click="LoadFiles_Click"
                                                ToolTip="List the files on GitHub and mark which ones changed"/>
                                    </Grid>
                                    <TextBlock x:Name="FilesSummary" Style="{StaticResource Hint}" Margin="0,0,0,8"/>

                                    <ItemsControl x:Name="GroupsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="groupBorder" Tag="{Binding}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,0,8" Background="{DynamicResource CardBrush}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleBrush}" CornerRadius="6,6,0,0" Padding="8,6"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ToggleButton IsChecked="{Binding IsExpanded}" Width="22" Height="22" Cursor="Hand"
                                                                                  ToolTip="Show or hide the files">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="Transparent">
                                                                                    <TextBlock x:Name="arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="arrow" Property="Text" Value="&#xE70D;"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding AllChecked, Mode=TwoWay}" Margin="4,0,6,0"
                                                                              VerticalAlignment="Center" ToolTip="Check or uncheck every file in this group"/>
                                                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                                                             BorderThickness="0" Background="Transparent" Padding="2,1" ToolTip="Group name (click to rename)"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                                                                               VerticalAlignment="Center" Margin="8,0"/>
                                                                    <Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="7,4"
                                                                            Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedBrush}"
                                                                            Tag="{Binding}" Click="RemoveGroup_Click" ToolTip="Delete this group"/>
                                                                </Grid>
                                                                <StackPanel Orientation="Horizontal" Margin="32,4,0,0">
                                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,0,16,0" FontSize="12"/>
                                                                    <CheckBox Content="Restart the program" IsChecked="{Binding RestartProgram}" Margin="0,0,16,0" FontSize="12"
                                                                              ToolTip="Close the program before replacing this group's files and start it again afterwards"/>
                                                                    <CheckBox Content="Refresh Edge (F5)" IsChecked="{Binding RefreshEdge}" FontSize="12"
                                                                              ToolTip="Refresh the active Microsoft Edge tab after this group's files are updated"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,2,0,2"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="row" Tag="{Binding}" Padding="10,4" Background="Transparent" Cursor="Hand"
                                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                                                            MouseLeftButtonDown="FileRow_MouseDown" MouseRightButtonUp="FileRow_RightClick"
                                                                            ToolTip="Drag onto another group to move it. Right-click for more.">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox IsChecked="{Binding Include}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                                <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource PlaceholderBrush}"/><Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                                                                            </TextBlock>
                                                                            <Border Grid.Column="2" x:Name="badge" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                                                                                    BorderBrush="Transparent" Margin="8,0,0,0" ToolTip="{Binding StateText}" Background="Transparent">
                                                                                <TextBlock x:Name="glyph" Text="" FontSize="11" FontWeight="Bold"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource SubtleBrush}"/>
                                                                        </Trigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Changed">
                                                                            <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource ChangedBrush}"/>
                                                                            <Setter TargetName="glyph" Property="Text" Value="•"/>
                                                                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource ChangedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="New">
                                                                            <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource SuccessFgBrush}"/>
                                                                            <Setter TargetName="glyph" Property="Text" Value="+"/>
                                                                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="NotOnGitHub">
                                                                            <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource ErrorFgBrush}"/>
                                                                            <Setter TargetName="glyph" Property="Text" Value="−"/>
                                                                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource ErrorFgBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="UpToDate">
                                                                            <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                                            <Setter TargetName="glyph" Property="Text" Value="✓"/>
                                                                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource PlaceholderBrush}"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter TargetName="groupBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="groupBorder" Property="Background" Value="{DynamicResource DropHighlightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter TargetName="groupBorder" Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid x:Name="DropZone" Height="58" Margin="0,2,0,0">
                                        <Rectangle Stroke="{DynamicResource DropStrokeBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="6" RadiusY="6" Fill="{DynamicResource DropBgBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="Drag files or folders here from File Explorer" FontWeight="SemiBold"/>
                                                <LineBreak/>
                                                <Run Text="Drop them onto a group to add them there. They must be inside the target folder." FontSize="11.5"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="4.  After updating" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="RestartCheck" Content="Start the program again" Margin="0,0,0,0"/>
                                    <CheckBox x:Name="EdgeCheck" Content="Refresh the active Microsoft Edge tab (F5)"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Used when the whole path is updated (section 3 is off). With file groups, each group has its own actions."/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Edge refresh brings the most recently used Edge window to the front, presses F5 and then gives focus back to the window you were using."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Automatic updates" Style="{StaticResource CardTitle}"/>

                                <CheckBox x:Name="AutoToggle" Style="{StaticResource ToggleSwitch}" Click="AutoToggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Update automatically" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock Text="When a file changes on GitHub, it is downloaded and installed in the background for every enabled target."
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Check GitHub every" VerticalAlignment="Center"/>
                                    <TextBox x:Name="IntervalBox" Width="60" Margin="8,0" TextAlignment="Center"/>
                                    <TextBlock Text="minutes" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="NotifyCheck" Content="Show the download animation and notifications" Margin="0,10,0,0"/>
                                <TextBlock x:Name="NextCheckText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Application" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="StartupCheck" Content="Start Multron Updater with Windows" Margin="0,0,0,0"/>
                                <CheckBox x:Name="MinimizedCheck" Content="Start hidden in the tray when started with Windows"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox x:Name="ThemeBox" Width="190" SelectedIndex="0">
                                        <ComboBoxItem Content="Use the Windows setting"/>
                                        <ComboBoxItem Content="Light"/>
                                        <ComboBoxItem Content="Dark"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Closing this window keeps Multron Updater running in the system tray. Use the tray icon menu to exit."/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Settings are saved automatically as you change them."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Multron developers" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="DevOptionsCheck" Content="Show Multron server options" Margin="0,0,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Only for Multron developers: adds the Multron server options (maintenance mode, signature reload, seamless update) to each target's &quot;Program on this computer&quot; section."/>
                                <StackPanel x:Name="DevGlobalPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Global server settings (used by every target that keeps &quot;Use the global server settings&quot;)" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Server dashboard" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="GlobalServerUrlBox" Grid.Column="1" FontFamily="Cascadia Mono, Consolas"
                                                 ToolTip="The server's dashboard address on this computer (its --ui address), e.g. http://127.0.0.1:9440"/>
                                        <TextBlock Grid.Column="2" Text="Wait up to" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                        <TextBox x:Name="GlobalDrainBox" Grid.Column="3" ToolTip="Seconds to wait for scans in progress (0-600)"/>
                                        <TextBlock Grid.Column="4" Text="s for scans" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Multron Updater updates" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionText" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock x:Name="SelfStatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SelfInstallButton" Content="Install update" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0" Visibility="Collapsed" Click="SelfInstall_Click"/>
                                        <Button x:Name="SelfCheckButton" Content="Check for updates" Margin="0,0,8,0" Click="SelfCheck_Click"/>
                                        <Button Content="Releases" Click="SelfReleases_Click" ToolTip="Open the releases page on GitHub"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="SelfUpdateCheck" Content="Update Multron Updater automatically" Margin="0,12,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="New versions come from the Releases of github.com/Multron-Community/Multron-Updater. Every push to the main branch builds a new release. The download is verified, the program replaces itself and starts again."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <DockPanel Margin="0,0,0,12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LevelFilter" Width="130" SelectedIndex="0" Padding="8,5" SelectionChanged="LogFilter_Changed">
                            <ComboBoxItem Content="All levels"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Success"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Error"/>
                        </ComboBox>
                        <Grid Grid.Column="1" Width="220" Margin="8,0,0,0">
                            <TextBox x:Name="SearchBox" TextChanged="LogFilter_Changed"/>
                            <TextBlock Text="Search logs..." Foreground="{DynamicResource PlaceholderBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Copy" Margin="0,0,6,0" Click="CopyLogs_Click" ToolTip="Copy the visible log lines"/>
                            <Button Content="Clear view" Margin="0,0,6,0" Click="ClearLogs_Click"/>
                            <Button Content="Open log file" Margin="0,0,6,0" Click="OpenLogFile_Click"/>
                            <Button Content="Open folder" Click="OpenLogFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView x:Name="LogList" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas"
                                  FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" Margin="2">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedBrush}"/>
                                        <Border Grid.Column="1" x:Name="badge" CornerRadius="3" Padding="5,0" Margin="0,0,8,0"
                                                HorizontalAlignment="Left" Background="{DynamicResource InfoBgBrush}">
                                            <TextBlock x:Name="lvl" Text="{Binding LevelText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InfoFgBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                            <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                            <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource WarnFgBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="badge" Property="Background" Value="{DynamicResource ErrorBgBrush}"/>
                                            <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource ErrorFgBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
