<Window x:Class="MultronUpdater.Views.DownloadToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multron Updater - Downloading"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        Icon="/Assets/app.ico" FontFamily="Segoe UI">

    <!-- Progress on the taskbar button -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" ProgressState="Indeterminate"/>
    </Window.TaskbarItemInfo>

    <Grid Margin="16,16,16,14">
        <Border x:Name="Root" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Opacity="0" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" X="420"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Animated icon: spinner while working, check mark / cross when done -->
                <Grid Width="36" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <Grid x:Name="SpinnerGroup">
                        <Ellipse Stroke="#30363D" StrokeThickness="3.5"/>
                        <Path x:Name="SpinnerArc" Stroke="#2EA043" StrokeThickness="3.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 18,1.75 A 16.25,16.25 0 0 1 34.25,18" RenderTransformOrigin="0.5,0.5"
                              Width="36" Height="36" Stretch="None">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="Spin" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="ArrowGlyph" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#2EA043" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="ArrowBob" Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <Grid x:Name="ResultGroup" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ResultScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="ResultCircle" Fill="#2EA043"/>
                        <TextBlock x:Name="ResultGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock x:Name="TitleText" Text="Downloading update" Foreground="White"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FileText" Text="Connecting to GitHub..." Foreground="#8B949E" FontSize="12"
                               Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#2EA043" Background="#30363D" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
                                    <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"/>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="DetailText" Foreground="#8B949E" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PercentText" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="2" x:Name="CloseButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        FontSize="10" Foreground="#8B949E" Background="Transparent" BorderBrush="Transparent"
                        Padding="6" VerticalAlignment="Top" Click="CloseButton_Click" ToolTip="Hide"/>
            </Grid>
        </Border>
    </Grid>
</Window>
